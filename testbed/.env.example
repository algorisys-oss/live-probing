# Copy to .env for local (non-docker) runs. Compose sets these itself.
# Host ports use a private range so Shopwave never collides with other stacks.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=shopwave
POSTGRES_PASSWORD=shopwave
REDIS_URL=redis://localhost:56379
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:24318
CATALOG_URL=http://localhost:3002
GATEWAY_PORT=3000
CATALOG_PORT=3002
